{
  "name": "excel-merger",
  "private": true,
  "version": "1.0.0",
  "description": "Excel 統合ツール — 複数のExcelをID・氏名で結合し、数式・書式を保ったまま列を並べ替えて出力するローカルアプリ",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "start": "node server/server.mjs",
    "build:runner": "node server/excel/build-runner.mjs",
    "build:exe": "node scripts/build-exe.mjs",
    "release": "node scripts/make-release.mjs",
    "samples": "node tools/make-samples.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "encoding-japanese": "^2.2.0",
    "fastest-levenshtein": "^1.0.16",
    "jszip": "^3.10.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/encoding-japanese": "^2.2.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "postject": "^1.0.0-alpha.6",
    "resedit": "^3.1.0",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.0"
  }
}
